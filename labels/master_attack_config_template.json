{
    "description": "Master template for Layer 2 attack labeling configuration",
    "version": "1.0",
    "created_date": "2025-08-26",
    
    "global_settings": {
        "layer_2_only": true,
        "comment": "Set to true for Layer 2 attacks only, false for attacks affecting both L2/L3"
    },
    
    "attacker_information": {
        "comment": "REPLACE ALL PLACEHOLDER VALUES WITH ACTUAL ATTACK DATA",
        "primary_attacker": {
            "ip": "ATTACKER_IP_PLACEHOLDER",
            "mac": "ATTACKER_MAC_PLACEHOLDER",
            "label": "Primary Attacker",
            "description": "Main attacking device"
        },
        "secondary_attacker": {
            "ip": "SECONDARY_ATTACKER_IP_PLACEHOLDER", 
            "mac": "SECONDARY_ATTACKER_MAC_PLACEHOLDER",
            "label": "Secondary Attacker",
            "description": "Secondary attacking device (if applicable)"
        }
    },
    
    "victim_information": {
        "comment": "Add legitimate devices being targeted",
        "primary_target": {
            "ip": "TARGET_IP_PLACEHOLDER",
            "mac": "TARGET_MAC_PLACEHOLDER", 
            "label": "Attack Target",
            "description": "Primary device being attacked"
        },
        "infrastructure_targets": {
            "gateway": {
                "ip": "GATEWAY_IP_PLACEHOLDER",
                "mac": "GATEWAY_MAC_PLACEHOLDER"
            },
            "dhcp_server": {
                "ip": "DHCP_SERVER_IP_PLACEHOLDER",
                "mac": "DHCP_SERVER_MAC_PLACEHOLDER"
            },
            "switches": {
                "primary_switch": {
                    "mac": "SWITCH_MAC_PLACEHOLDER",
                    "management_ip": "SWITCH_MGMT_IP_PLACEHOLDER"
                }
            }
        }
    },
    
    "time_based_labeling_template": {
        "comment": "Template for time-based attack labeling",
        "time_labels": [
            {
                "comment": "Customize time range and attack description",
                "time_range": "HH:MM-HH:MM",
                "label": "Attack Name",
                "description": "Description of what happens during this time"
            }
        ]
    },
    
    "protocol_specific_labeling_template": {
        "comment": "Template for protocol-specific labeling",
        "protocol_specific_labels": [
            {
                "comment": "Target specific protocols during attack times",
                "protocols": ["PROTOCOL1", "PROTOCOL2"],
                "time_range": "HH:MM-HH:MM",
                "label": "Protocol-Specific Attack",
                "description": "Attack targeting specific protocols",
                "port_filter": "Optional - for UDP/TCP attacks",
                "additional_criteria": "Optional - add specific conditions"
            }
        ]
    },
    
    "recurring_attack_template": {
        "comment": "Template for recurring attacks (like VLAN, ARP Poisoning)",
        "recurring_pattern": {
            "start_time": "HH:MM",
            "end_time": "HH:MM", 
            "interval_minutes": 0,
            "attack_duration_seconds": 0,
            "attack_duration_minutes": 0,
            "rest_duration_minutes": 0
        }
    },
    
    "layer2_protocols_reference": {
        "comment": "Common Layer 2 protocols for protocol-specific labeling",
        "spanning_tree": ["STP", "BPDU", "RSTP", "MSTP"],
        "discovery_protocols": ["CDP", "LLDP"],
        "arp_related": ["ARP"], 
        "vlan_related": ["DTP", "VTP", "VLAN"],
        "ethernet": ["ETH", "LLC", "SNAP"],
        "dhcp_related": ["DHCP", "BOOTP", "UDP"]
    },
    
    "attack_type_templates": {
        "arp_based_attacks": {
            "primary_protocols": ["ARP"],
            "secondary_protocols": ["ETH"],
            "key_indicators": ["gratuitous_arp", "arp_reply_flooding", "ip_mac_conflicts"]
        },
        "stp_based_attacks": {
            "primary_protocols": ["STP", "BPDU"],
            "secondary_protocols": ["RSTP", "MSTP"],
            "key_indicators": ["bridge_priority_manipulation", "topology_change_flooding"]
        },
        "cdp_based_attacks": {
            "primary_protocols": ["CDP"],
            "secondary_protocols": ["LLC", "SNAP"],
            "key_indicators": ["device_impersonation", "information_gathering"]
        },
        "dhcp_based_attacks": {
            "primary_protocols": ["DHCP", "BOOTP"],
            "secondary_protocols": ["UDP", "ARP"],
            "key_indicators": ["dhcp_flooding", "pool_exhaustion", "rogue_server"],
            "layer_2_only": false
        },
        "switch_spoofing_attacks": {
            "primary_protocols": ["STP", "CDP", "DTP"],
            "secondary_protocols": ["VTP", "LLDP"],
            "key_indicators": ["root_bridge_claims", "device_advertisements"]
        }
    },
    
    "usage_instructions": {
        "step1": "Copy this template and rename for specific attack type",
        "step2": "Set 'layer_2_only' to true for L2 attacks, false for L2/L3 attacks", 
        "step3": "Replace all PLACEHOLDER values with actual attacker/victim information",
        "step4": "Add specific time ranges from your attack timeline",
        "step5": "Configure protocol-specific labels based on attack type",
        "step6": "Test with: python -m src.flowlyzer.main -i data/ --label-config your_config.json"
    },
    
    "command_examples": [
        "python -m src.flowlyzer.main -i attack_data/ --label-config labels/your_attack_labels.json --separate-layers",
        "python -m src.flowlyzer.main -i attack_data/ --label-config labels/your_attack_labels.json --label-mac 'aa:bb:cc:dd:ee:ff=Attacker' --separate-layers"
    ]
}